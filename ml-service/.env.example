DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_pipeline
PORT=8001
HOST=0.0.0.0

# Comma-separated browser origins allowed to call this API (e.g. an admin
# dashboard). Leave empty/unset to block all browser origins. Does not affect
# server-to-server calls from the Rust backend.
ALLOWED_ORIGINS=

# Shared secret required in the X-API-Key header to call POST /retrain and
# POST /export-training-data. Required — if unset, those two endpoints reject
# every request (no unauthenticated dev bypass). Generate with: openssl rand -hex 32
ML_RETRAIN_API_KEY=

# Whisper speech-to-text (POST /transcribe), used for voice-recorded
# consultation notes. Runs self-hosted via faster-whisper — no audio leaves
# this service. Model downloads from Hugging Face on first use and is cached
# under ~/.cache/huggingface after that.
# Sizes (accuracy vs. speed/download): tiny < base < small < medium < large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
# int8 is fastest on CPU; use float16 if WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
